
# App
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Database
MONGODB_URI=mongodb://localhost:27017/autobeli
# Playwright only: use a separate database whose name contains "e2e".
E2E_MONGODB_URI=mongodb://localhost:27017/autobeli_e2e

# Admin
ADMIN_PASSWORD=

# Auth
JWT_SECRET=changeme

# Security
CONTENT_ENCRYPTION_KEY=12345678901234567890123456789012

# Payment Gateway
# MOCK for local development only; use QRIS in production.
PAYMENT_GATEWAY=MOCK

# Qris payment gateway (production)
# Machine API key created in the Qris admin panel (not the panel's PANEL_API_KEY).
# QRIS_WEBHOOK_HMAC_KEY must equal the Qris server's WEBHOOK_HMAC_KEY.
# NEXT_PUBLIC_BASE_URL must be a public HTTPS AutoBeli URL so Qris can reach the webhook.
QRIS_API_BASE_URL=https://qris.onrender.com
QRIS_API_KEY=
QRIS_WEBHOOK_HMAC_KEY=

# Pakasir (legacy — kept only to reconcile historical orders)
PAKASIR_API_KEY=
PAKASIR_PROJECT_SLUG=

# Cloudflare outbound email worker
# Example URL: https://<your-workers-subdomain>.workers.dev/api/outbound/purchase
CLOUDFLARE_EMAIL_API_URL=
CLOUDFLARE_EMAIL_API_KEY=
CLOUDFLARE_EMAIL_FROM=noreply@akunlama.com
CLOUDFLARE_EMAIL_FROM_NAME=AutoBeli
CLOUDFLARE_EMAIL_REPLY_TO=

# Optional local-development fallback when Cloudflare email is unavailable
EMAIL_DEV_FALLBACK=0
EMAIL_DEV_OUTBOX_DIR=

